# Copy this file to ".env" (setup.bat does it for you). NEVER commit the real .env file.
# The API key lives only here, on the server side. The browser never receives it.
# You can also fill these in from Settings -> Online AI inside MITRA.

# anthropic | openai | openai-compatible
AI_PROVIDER=anthropic
AI_API_KEY=
# Example only - use a model name your provider offers, e.g. claude-sonnet-5-5
AI_MODEL=
# Only for openai-compatible / local servers, e.g. http://localhost:11434/v1
AI_BASE_URL=

AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=2000
AI_DAILY_LIMIT=100

# Server (keep HOST on 127.0.0.1 so only this computer can open MITRA)
HOST=127.0.0.1
PORT=3000

MAX_UPLOAD_MB=20
MAX_RESTORE_MB=1024
# Text recognition for photos of notes (needs the optional tesseract.js package)
OCR_ENABLED=true
OCR_LANGS=eng
# MITRA_DATA_DIR=C:\MITRA-data
